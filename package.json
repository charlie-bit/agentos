{
  "name": "agentos",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "e2e:agent": "node --env-file-if-exists=.env scripts/agent-e2e.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose restart agentos",
    "docker:logs": "docker compose logs -f agentos",
    "docker:watch": "docker compose watch",
    "docker:token": "docker compose logs agentos | grep -E 'link:|token:' | tail -n 2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.25.12",
    "eslint": "^9.17.0",
    "mcp-sumologic": "1.0.20",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
