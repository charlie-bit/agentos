node_modules/
dist/
.env*
*.log
.DS_Store

# local working dirs (design scratch / vendored public references)
pm-skills-temp/
.reference/
*.local

# local-only preset: mounts providers whose credentials stay in .env.local
config/presets/local.yml

# third-party design skill, linked from a local checkout — not part of the product
.claude/skills/impeccable
# impeccable working artifacts; PRODUCT.md and surface briefs stay tracked
apps/web/.impeccable/mocks/
apps/web/.impeccable/build/
apps/web/.impeccable/review/
apps/web/.impeccable/config.local.json

# session ledger database (default location; path overridable via AGENTOS_SESSION_DB)
.agentos/

# knowledge socket: content never ships with the app; only the README is tracked
knowledge-base/*
!knowledge-base/README.md
.claude/settings.local.json

# docker demo data volume
.agentos-docker/

# skills socket: private/local instruction directories never ship with the app
skills-base/*
!skills-base/README.md
config/skills/local.yml
